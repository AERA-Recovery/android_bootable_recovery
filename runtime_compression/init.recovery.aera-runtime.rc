# Added to the packed CPIO only when AERA_USE_EXTREME_COMPRESSION := 1.
on early-init
    chmod 0755 /sbin/busybox
    exec u:r:recovery:s0 root root -- /sbin/busybox sh /aera-runtime-unpack.sh
    restorecon_recursive /system /vendor /twres
