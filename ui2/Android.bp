package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "aera-browser-jail",
    recovery: true,
    srcs: ["browser/jail_main.cpp"],
    static_executable: true,
    stl: "libc++_static",
    static_libs: ["libminijail", "libcap"],
    cpp_std: "c++17",
    cflags: ["-Wall", "-Wextra", "-Werror"],
}

cc_library_static {
    name: "librecoveryui2",
    recovery_available: true,
    srcs: [
        "android_icon.cpp",
        "boot_scene.cpp",
        "appvault_scene.cpp",
        "browser_scene.cpp",
        "browser/runtime.cpp",
        "browser/launcher.cpp",
        "browser/session.cpp",
        "browser/web_scene.cpp",
        "decrypt_scene.cpp",
        "engine.cpp",
        "fastboot_scene.cpp",
        "fonts/aera_latin_16.c",
        "fonts/aera_latin_18.c",
        "fonts/aera_latin_20.c",
        "fonts/aera_latin_24.c",
        "fonts/aera_latin_28.c",
        "fonts/aera_latin_32.c",
        "fonts/aera_latin_36.c",
        "fonts/aera_latin_40.c",
        "fonts/aera_latin_48.c",
        "gpu_renderer.cpp",
        "gallery_scene.cpp",
        "generic_plugin_scene.cpp",
        "home_scene.cpp",
        "launcher_scene.cpp",
        "lock_scene.cpp",
        "media_scene.cpp",
        "media/launcher.cpp",
        "media/session.cpp",
        "nas_scene.cpp",
        "operation_scene.cpp",
        "picture_decode.cpp",
        "picture_viewer.cpp",
        "plugin_scene.cpp",
        "plugins/plugin_manager.cpp",
        "plugin_api/launcher.cpp",
        "plugin_api/session.cpp",
        "recorder/service.cpp",
        "recorder_scene.cpp",
        "reboot_scene.cpp",
        "root_manager.cpp",
        "root_manager_scene.cpp",
        "retroarch_icon.cpp",
        "retroarch_scene.cpp",
        "retroarch/launcher.cpp",
        "retroarch/session.cpp",
        "telegram/launcher.cpp",
        "telegram_scene.cpp",
        "terminal_scene.cpp",
        "tool_scene.cpp",
        "update/update_manager.cpp",
        "update_scene.cpp",
        "wifi_scene.cpp",
        "webkit_icon.cpp",
        "runner.cpp",
        "status_bar.cpp",
    ],
    export_include_dirs: ["include"],
    local_include_dirs: ["browser/prebuilt"],
    cpp_std: "c++17",
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-Wno-unused-function",
        "-fdata-sections",
        "-ffunction-sections",
    ],
    include_dirs: [
        "bootable/recovery",
        "bootable/recovery/gui",
        "bootable/recovery/gui/include",
        "bootable/recovery/libpixelflinger/include",
        "bootable/recovery/minuitwrp/include",
        "bootable/recovery/twrpinstall/include",
    ],
    header_libs: [
        "libarect_headers",
        "libnativewindow_headers",
    ],
    static_libs: [
        "libaera_webp_decoder",
        "liblvgl_recovery",
        "libxz",
        "libjsoncpp",
    ],
    shared_libs: [
        "libandroidfw",
        "libcutils",
        "liblog",
        "libminuitwrp",
        "libpng",
        "libselinux",
        "libutils",
        "libziparchive",
        "libcrypto",
        "libdl",
    ],
}
