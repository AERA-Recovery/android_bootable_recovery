bootstrap_go_package {
    pkgPath: "bootable/recovery/gui",
    deps: [
        "soong",
        "soong-android",
        "soong-cc"
    ],
    srcs: [
        "../soong/copy.go",
        "../soong/makevars.go",
        "../orangefox_defaults.go"
    ],
    pluginFor: ["soong_build"]
}

}

aera_ui2_defaults {
    name: "aera_ui2_defaults"
}

// FoxUiEngine - the OrangeFox UI engine static library (formerly libguitwrp).
cc_library_static {
    rtti: true,
    cflags: [
        "-fno-strict-aliasing", 
        "-Wno-implicit-fallthrough",
        "-Wno-unused-parameter",
        "-Wno-unused-function",
        "-Wno-unused-variable",
        "-D_USE_SYSTEM_ZIPARCHIVE",
        "-DTWRES=\"/twres/\""
    ],
    include_dirs: [
        "bootable/recovery/otautil/include",
        "bootable/recovery/install/include",
        "system/libziparchive/include",
        "bootable/recovery/recovery_ui/include",
        "bootable/recovery/fuse_sideload/include",
        "bootable/recovery/gui/include",
        "bootable/recovery/twrpinstall",
        "bootable/recovery/twrpinstall/include",
        "bootable/recovery/libpixelflinger/include",
        "bootable/recovery/minuitwrp/include",
        "bionic",
        "system/libbase/include",
        "system/core/libcutils/include",
        "system/core/include",
        "external/freetype/include",
        "external/libpng",
        "external/jsoncpp/include",
        "external/libvterm/include"

    ],
    srcs: [
        "gui.cpp",
        "resources.cpp",
        "pages.cpp",
        "text.cpp",
        "image.cpp",
        "action.cpp",
        "console.cpp",
        "fill.cpp",
        "button.cpp",
        "checkbox.cpp",
        "fileselector.cpp",
        "progressbar.cpp",
        "animation.cpp",
        "spinningimage.cpp",
        "object.cpp",
        "slider.cpp",
        "slidervalue.cpp",
        "listbox.cpp",
        "keyboard.cpp",
        "input.cpp",
        "blanktimer.cpp",
        "partitionlist.cpp",
        "mousecursor.cpp",
        "scrolllist.cpp",
        "scrollcontainer.cpp",
        "toggle.cpp",
        "card.cpp",
        "patternpassword.cpp",
        "textbox.cpp",
        "terminal.cpp",
        "twmsg.cpp",
        // OrangeFox
        "gesture.cpp",
        "battery.cpp",
        "aera_bridge.cpp",
    ],
    shared_libs: [
        "libminuitwrp",
        "libft2",
        "libc",
        "libstdc++",
        "libaosprecovery",
        "libselinux",
        "libziparchive"
    ],
    static_libs: [
        "librecoveryui2",
        "liblvgl_recovery",
        "libotautil",
        "libpng"
    ]
}
