package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "aera-browser-jail",
    recovery: true,
    srcs: ["features/browser/jail_main.cpp"],
    static_executable: true,
    stl: "libc++_static",
    static_libs: ["libminijail", "libcap"],
    cpp_std: "c++17",
    cflags: ["-Wall", "-Wextra", "-Werror"],
}

cc_library_static {
    name: "libaeraui",
    defaults: ["aeraui_defaults"],
    recovery_available: true,
    srcs: [
        "components/aera_logo.cpp",
        "components/android_icon.cpp",
        "components/matrix_engraving.cpp",
        "components/picture_decode.cpp",
        "components/picture_viewer.cpp",
        "components/retroarch_icon.cpp",
        "components/webkit_icon.cpp",
        "core/engine.cpp",
        "core/gpu_renderer.cpp",
        "core/runner.cpp",
        "core/status_bar.cpp",
        "features/browser/launcher.cpp",
        "features/browser/runtime.cpp",
        "features/browser/session.cpp",
        "features/browser/web_scene.cpp",
        "features/doom/launcher.cpp",
        "features/doom/session.cpp",
        "features/files/file_manager.cpp",
        "features/media/launcher.cpp",
        "features/media/session.cpp",
        "features/plugin_api/launcher.cpp",
        "features/plugin_api/session.cpp",
        "features/plugins/plugin_manager.cpp",
        "features/recorder/service.cpp",
        "features/retroarch/launcher.cpp",
        "features/retroarch/session.cpp",
        "features/root/root_manager.cpp",
        "features/streams/launcher.cpp",
        "features/streams/query.cpp",
        "features/streams/session.cpp",
        "features/telegram/launcher.cpp",
        "features/update/update_manager.cpp",
        "localization/catalog/catalog_generated.cpp",
        "localization/fonts/aera_fallback.cpp",
        "localization/i18n.cpp",
        "scenes/about_scene.cpp",
        "scenes/appvault_scene.cpp",
        "scenes/boot_scene.cpp",
        "scenes/browser_scene.cpp",
        "scenes/decrypt_scene.cpp",
        "scenes/doom_scene.cpp",
        "scenes/fastboot_scene.cpp",
        "scenes/gallery_scene.cpp",
        "scenes/generic_plugin_scene.cpp",
        "scenes/home_scene.cpp",
        "scenes/launcher_scene.cpp",
        "scenes/lock_scene.cpp",
        "scenes/media_scene.cpp",
        "scenes/nas_scene.cpp",
        "scenes/operation_scene.cpp",
        "scenes/plugin_scene.cpp",
        "scenes/reboot_scene.cpp",
        "scenes/recorder_scene.cpp",
        "scenes/retroarch_scene.cpp",
        "scenes/root_manager_scene.cpp",
        "scenes/sideload_scene.cpp",
        "scenes/streams_scene.cpp",
        "scenes/telegram_scene.cpp",
        "scenes/terminal_scene.cpp",
        "scenes/tool_scene.cpp",
        "scenes/update_scene.cpp",
        "scenes/wifi_scene.cpp",
    ],
    export_include_dirs: ["include"],
    local_include_dirs: [
        ".",
        "assets",
        "components",
        "core",
        "features",
        "features/browser/prebuilt",
        "features/files",
        "features/root",
        "localization",
        "localization/fonts",
        "scenes",
        "third_party/nanosvg",
    ],
    cpp_std: "c++17",
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-Wno-unused-function",
        "-fdata-sections",
        "-ffunction-sections",
    ],
    include_dirs: [
        "bootable/recovery",
        "bootable/recovery/libpixelflinger/include",
        "bootable/recovery/minuitwrp/include",
        "bootable/recovery/twrpinstall/include",
    ],
    header_libs: [
        "libarect_headers",
        "libnativewindow_headers",
    ],
    static_libs: [
        "libaera_webp_decoder",
        "liblvgl_recovery",
        "libxz",
        "libjsoncpp",
    ],
    shared_libs: [
        "libandroidfw",
        "libcutils",
        "liblog",
        "libminuitwrp",
        "libpng",
        "libselinux",
        "libutils",
        "libziparchive",
        "libcrypto",
        "libdl",
    ],
}
